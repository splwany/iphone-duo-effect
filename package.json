{
  "name": "iphone-duo-effect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests examples index.html vite*.config.ts tsconfig*.json package.json",
    "format:check": "prettier --check src tests examples index.html vite*.config.ts tsconfig*.json package.json",
    "test:browser": "node tests/browser.mjs",
    "test:parameters": "node tests/parameters.mjs",
    "build:sdk": "vite build --config vite.sdk.config.ts && tsc -p tsconfig.sdk.json",
    "test:sdk": "node tests/sdk-browser.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^24.0.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "prettier": "^3.6.0",
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
